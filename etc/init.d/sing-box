#!/bin/bash
DAEMON="/usr/local/bin/sing-box"
CONFIG="/etc/sing-box/config.json"
LOG="/var/log/sing-box.log"

case "$1" in
  start)
    mkdir -p "$(dirname "$LOG")"
    setsid "$DAEMON" run -c "$CONFIG" >> "$LOG" 2>&1 &
    ;;
  stop)
    pkill -x "$(basename "$DAEMON")"
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  status|*)
    [ -f "$LOG" ] && tail -n 50 -f "$LOG" || echo "暂无日志文件：$LOG"
    ;;
esac
